# Vent — environment variables
#
# Copy this file to `.env` for local development, then fill in the values below.
# In Netlify, set these under:
#   Site settings → Environment variables → Functions scope
#
# Without these set, the site runs in demo mode and shows sample messages.

# Discord bot token.
# Create an application + bot at https://discord.com/developers/applications,
# then copy the token from the "Bot" page.
# Required permissions for the bot in your guild:
#   - View Channel
#   - Read Message History
# Required privileged intent (enable in Developer Portal → Bot → Privileged Gateway Intents):
#   - MESSAGE_CONTENT
DISCORD_BOT_TOKEN=

# Discord channel ID to read messages from.
# Right-click the channel in Discord (with Developer Mode enabled in Settings → Advanced)
# and choose "Copy Channel ID".
DISCORD_CHANNEL_ID=
